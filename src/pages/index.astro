---
import Layout from '~/layouts/Layout.astro';
import BeaconBrand from '~/components/beacon/BeaconBrand.astro';
import TeamMember from '~/components/beacon/TeamMember.astro';
import InvolvementCard from '~/components/beacon/InvolvementCard.astro';
import teamBoard from '~/assets/images/beacon/reference-team-board.png';
import utsaLogo from '~/assets/images/beacon/logos/utsa.png';
import utAustinDellLogo from '~/assets/images/beacon/logos/ut-austin-dell.png';
import utHealthHoustonLogo from '~/assets/images/beacon/logos/uthealth-houston.png';
import utSouthwesternLogo from '~/assets/images/beacon/logos/utsouthwestern.png';
import utTylerLogo from '~/assets/images/beacon/logos/ut-tyler.png';
import utmbLogo from '~/assets/images/beacon/logos/utmb.png';
import stracLogo from '~/assets/images/beacon/logos/strac.png';
import utrgvLogo from '~/assets/images/beacon/logos/utrgv.png';
import paloBioLogo from '~/assets/images/beacon/logos/palobio.png';
import matrixLogo from '~/assets/images/beacon/logos/matrix.png';
import loneStarStrokeLogo from '~/assets/images/beacon/logos/lone-star-stroke.png';
import utSystemLogo from '~/assets/images/beacon/logos/ut-system.png';
import seljaAiLogo from '~/assets/images/beacon/logos/selja-ai.png';
import { goals, involvement, people, stats } from '~/data/beacon';

const collaboratorLogoItems = [
  { name: 'UT San Antonio', image: utsaLogo },
  { name: 'The University of Texas at Austin Dell Medical School', image: utAustinDellLogo },
  { name: 'UTHealth Houston', image: utHealthHoustonLogo },
  { name: 'UT Southwestern Medical Center', image: utSouthwesternLogo },
  { name: 'UT Tyler', image: utTylerLogo },
  { name: 'UTMB', image: utmbLogo },
  { name: 'STRAC', image: stracLogo },
  { name: 'UTRGV', image: utrgvLogo },
  { name: 'Palo Bio', image: paloBioLogo, className: 'is-square' },
  { name: 'The UTSA AI Consortium for Human Well-Being', image: matrixLogo },
  { name: 'Lone Star Stroke Research Consortium', image: loneStarStrokeLogo, className: 'is-square' },
  { name: 'The University of Texas System', image: utSystemLogo, className: 'is-square' },
  { name: 'Selja AI', image: seljaAiLogo, className: 'is-mark' },
];

const metadata = {
  title: 'BEACON — Bedside Emergency AI for Care Orchestration',
  description:
    'BEACON brings clinicians, engineers, AI researchers, and startup partners together to improve emergency decisions and recovery after trauma, brain injury, and stroke.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <header class="site-header">
    <div class="nav-wrap">
      <a href="#top" class="brand-link" aria-label="BEACON home"><BeaconBrand compact /></a>
      <nav class="desktop-nav" aria-label="Primary navigation">
        <a href="#mission">Mission</a>
        <a href="#impact">Impact</a>
        <a href="#team">People</a>
        <a href="#involve" class="nav-cta">Get involved</a>
      </nav>
      <details class="mobile-nav">
        <summary aria-label="Open navigation"><span></span><span></span></summary>
        <nav aria-label="Mobile navigation">
          <a href="#mission">Mission</a>
          <a href="#impact">Impact</a>
          <a href="#team">People</a>
          <a href="#involve">Get involved</a>
        </nav>
      </details>
    </div>
  </header>

  <main id="top">
    <section class="hero section-shell" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow"><span></span> UT REAL Health AI Innovation Moonshot</p>
        <h1 id="hero-title">Lighting the way during the <em>minutes</em> that matter most.</h1>
        <p class="hero-lede">
          <strong>BEACON — Bedside Emergency AI for Care Orchestration</strong> brings clinicians, engineers, AI researchers,
          and startup partners together to support faster emergency decisions — and better recovery after trauma, brain injury,
          and stroke.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="#mission">See the mission <span aria-hidden="true">↓</span></a>
          <a class="button button-ghost" href="#involve">Get involved <span aria-hidden="true">↗</span></a>
        </div>
        <p class="human-note"><span class="human-dot"></span> Human expertise stays in the loop.</p>
      </div>

      <div class="hero-visual hero-gif" role="img" aria-label="Animated BEACON journey from Emergency and Selja decision support to an illuminated path and Recovery support.">
        <img
          src="/images/beacon/beacon-hero-journey-900x600.gif"
          alt="Emergency and Selja decision support illuminate red, followed by the BEACON moon, the path to recovery, and the Recovery continuous support sign."
          width="600"
          height="900"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
    </section>

    <section class="stats-band" id="impact" aria-label="BEACON project scale">
      <div class="stats-grid section-shell">
        {
          stats.map((stat) => (
            <div class="stat-item">
              <strong>{stat.value}</strong>
              <div>
                <span>{stat.label}</span>
                <small>{stat.detail}</small>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <section class="mission section-shell" id="mission" aria-labelledby="mission-title">
      <div class="section-intro mission-intro">
        <p class="eyebrow"><span></span> The mission</p>
        <h2 id="mission-title">One connected system, from the first decision to the long recovery.</h2>
        <p>
          BEACON is building a clinician-guided AI ecosystem that spans the trauma journey, and improves patient outcomes and recovery.
        </p>
      </div>

      <div class="journey" aria-label="Three BEACON goals">
        <div class="journey-line" aria-hidden="true"><span></span></div>
        {
          goals.map((goal) => (
            <article class={`goal-card goal-${goal.accent}`}>
              <div class="goal-top">
                <span class="goal-number">{goal.number}</span>
                <span class="goal-phase">{goal.phase}</span>
              </div>
              <div class="goal-node" aria-hidden="true">
                <span />
              </div>
              <h3>{goal.title}</h3>
              <p>{goal.description}</p>
            </article>
          ))
        }
      </div>

      <div class="principle-strip">
        <p class="principle-label">Design principles</p>
        <div class="principle-grid">
          <article class="principle-item">
            <span class="principle-item-label">Design Principle 1</span>
            <p class="principle-quote">
              “Augment the information available to clinicians when critical decisions have to be made.”
            </p>
          </article>
          <article class="principle-item">
            <span class="principle-item-label">Design Principle 2</span>
            <p class="principle-quote">
              “Improve communication for trauma and stroke patients and their care providers.”
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="team-section" id="team" aria-labelledby="team-title">
      <div class="section-shell">
        <div class="section-intro team-intro">
          <div>
            <p class="eyebrow"><span></span> The people</p>
            <h2 id="team-title">Built by a rare coalition of experts, united around better care.</h2>
          </div>
          <p>
            Trauma surgery, critical care, neurology, biomedical engineering, and AI — working side by side. Click a
            portrait to learn more.
          </p>
        </div>

        <div class="team-grid">
          {people.map((person) => <TeamMember person={person} />)}
        </div>

        <div class="team-note">
          <span class="team-note-count">30+</span>
          <p>
            <strong>One multidisciplinary team.</strong> Clinicians, AI researchers, engineers, psychologists, therapists, nurses, startup partners, 
            and collaborators across the UT system and partner institutions.
          </p>
        </div>

        <div class="collaborator-gallery">
          <div class="collaborator-copy">
            <p class="eyebrow"><span></span> The wider collaborator community</p>
            <h3>Across institutions, startups, and clinical environments.</h3>
            <p>
              BEACON is powered by a broader network of collaborators contributing clinical expertise, implementation insight,
              AI development, rehabilitation knowledge, and survivor-centered perspectives.
            </p>
          </div>

          <figure class="collaborator-board">
            <img
              src={teamBoard.src}
              width={teamBoard.width}
              height={teamBoard.height}
              alt="Illustrated group image showing the broader BEACON collaborator community."
              loading="lazy"
            />
          </figure>
        </div>

        <div class="logo-wall">
          <div class="logo-wall-copy">
            <p class="eyebrow"><span></span> Collaborating organizations</p>
            <h3>Partner institutions and affiliated collaborators.</h3>
          </div>
          <div class="logo-grid">
            {
              collaboratorLogoItems.map((logo) => (
                <div class={`logo-item ${logo.className ?? ''}`}>
                  <img
                    src={logo.image.src}
                    width={logo.image.width}
                    height={logo.image.height}
                    alt={`${logo.name} logo`}
                    loading="lazy"
                  />
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section class="involve-section" id="involve" aria-labelledby="involve-title">
      <div class="section-shell involve-shell">
        <div class="section-intro involve-intro">
          <p class="eyebrow eyebrow-light"><span></span> Be part of what comes next</p>
          <h2 id="involve-title">There is a role for people who fund, build, care, and recover.</h2>
          <p>
            Choose a path to see how you can help BEACON move from a pilot into a durable trauma and stroke care
            ecosystem.
          </p>
        </div>

        <div class="involve-grid">
          {involvement.map((item, index) => <InvolvementCard item={item} index={index} />)}
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="section-shell footer-inner">
      <BeaconBrand compact />
      <p>Bedside Emergency AI for Care Orchestration</p>
      <p class="footer-meta">Trauma + stroke · emergency decisions + recovery · human-guided AI</p>
    </div>
  </footer>

  <script is:inline>
    const setupBeaconDialogs = () => {
      document.querySelectorAll('[data-open-person]').forEach((button) => {
        if (button.dataset.bound) return;
        button.dataset.bound = 'true';
        button.addEventListener('click', () => {
          const id = button.getAttribute('data-open-person');
          document.querySelector(`[data-person-dialog="${id}"]`)?.showModal();
        });
      });

      document.querySelectorAll('[data-open-involvement]').forEach((button) => {
        if (button.dataset.bound) return;
        button.dataset.bound = 'true';
        button.addEventListener('click', () => {
          const id = button.getAttribute('data-open-involvement');
          document.querySelector(`[data-involvement-dialog="${id}"]`)?.showModal();
        });
      });

      document.querySelectorAll('[data-close-dialog]').forEach((button) => {
        if (button.dataset.bound) return;
        button.dataset.bound = 'true';
        button.addEventListener('click', () => button.closest('dialog')?.close());
      });

      document.querySelectorAll('dialog').forEach((dialog) => {
        if (dialog.dataset.backdropBound) return;
        dialog.dataset.backdropBound = 'true';
        dialog.addEventListener('click', (event) => {
          const rect = dialog.getBoundingClientRect();
          const inside =
            event.clientX >= rect.left &&
            event.clientX <= rect.right &&
            event.clientY >= rect.top &&
            event.clientY <= rect.bottom;
          if (!inside) dialog.close();
        });
      });

      document.querySelectorAll('.mobile-nav a').forEach((link) => {
        if (link.dataset.bound) return;
        link.dataset.bound = 'true';
        link.addEventListener('click', () => link.closest('details')?.removeAttribute('open'));
      });
    };

    const setupHeroJourney = () => {
      const hero = document.querySelector('[data-hero-path]');
      if (!hero || hero.dataset.bound) return;
      hero.dataset.bound = 'true';

      const basePath = hero.querySelector('[data-path-base]');
      const progressPath = hero.querySelector('[data-path-progress]');
      const stageCopy = hero.querySelector('[data-stage-copy]');
      const triggers = hero.querySelectorAll('[data-stage-trigger]');
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const stages = {
        emergency: {
          progress: 0.18,
          copy: 'Emergency decision support lights the first critical steps and points clinicians toward the right care.',
        },
        orchestration: {
          progress: 0.58,
          copy: 'At the bedside, BEACON helps coordinate information, transfers, and context during the care journey.',
        },
        recovery: {
          progress: 1,
          copy: 'Recovery stays connected, with continuous support for survivors, families, and care teams.',
        },
      };

      const setProgress = (amount) => {
        if (!basePath || !progressPath) return;
        const length = basePath.getTotalLength();
        progressPath.style.strokeDasharray = `${length}`;
        progressPath.style.strokeDashoffset = `${length * (1 - amount)}`;
      };

      const setStage = (name) => {
        const stage = stages[name] || stages.emergency;
        hero.dataset.activeStage = name;
        if (stageCopy) stageCopy.textContent = stage.copy;
        setProgress(stage.progress);
      };

      let intervalId = null;
      const order = ['emergency', 'orchestration', 'recovery'];
      let currentIndex = 0;

      const stopAuto = () => {
        if (intervalId) {
          window.clearInterval(intervalId);
          intervalId = null;
        }
      };

      const startAuto = () => {
        if (prefersReducedMotion) return;
        stopAuto();
        intervalId = window.setInterval(() => {
          currentIndex = (currentIndex + 1) % order.length;
          setStage(order[currentIndex]);
        }, 3200);
      };

      triggers.forEach((trigger) => {
        if (trigger.dataset.heroBound) return;
        trigger.dataset.heroBound = 'true';
        const stageName = trigger.getAttribute('data-stage-trigger');
        const activate = () => {
          currentIndex = Math.max(order.indexOf(stageName), 0);
          setStage(stageName);
          stopAuto();
        };
        trigger.addEventListener('mouseenter', activate);
        trigger.addEventListener('focus', activate);
        trigger.addEventListener('click', activate);
      });

      hero.addEventListener('mouseleave', startAuto);
      setStage('emergency');
      startAuto();
    };

    const initBeaconPage = () => {
      setupBeaconDialogs();
      setupHeroJourney();
    };

    initBeaconPage();
    document.addEventListener('astro:page-load', initBeaconPage);
  </script>
</Layout>

<style is:global>
  :root {
    --beacon-orange: #f4511e;
    --beacon-burnt: #d65d2c;
    --beacon-gold: #f5a623;
    --beacon-cream: #fffaf4;
    --beacon-ink: #15283d;
    --beacon-blue: #456fa6;
    --beacon-blue-pale: #e9f0f8;
    --beacon-slate: #60748b;
    --beacon-green: #627a45;
    --beacon-line: rgba(21, 40, 61, 0.12);
  }

  html {
    scroll-padding-top: 5.5rem;
  }
  body {
    background: #fffdfa;
    color: var(--beacon-ink);
  }
  body,
  button,
  input,
  textarea {
    font-family: 'Inter Variable', Inter, ui-sans-serif, system-ui, sans-serif;
  }
  ::selection {
    background: rgba(245, 166, 35, 0.3);
    color: var(--beacon-ink);
  }

  .section-shell {
    width: min(1180px, calc(100% - 2rem));
    margin-inline: auto;
  }
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgba(255, 253, 250, 0.86);
    border-bottom: 1px solid rgba(21, 40, 61, 0.07);
    backdrop-filter: blur(18px);
  }
  .nav-wrap {
    width: min(1180px, calc(100% - 2rem));
    height: 4.85rem;
    margin-inline: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }
  .brand-link {
    display: inline-flex;
    text-decoration: none;
  }
  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.88rem;
    font-weight: 700;
  }
  .desktop-nav a {
    color: #4e6378;
    text-decoration: none;
    padding: 0.65rem 0.82rem;
    border-radius: 999px;
    transition:
      color 0.2s ease,
      background 0.2s ease;
  }
  .desktop-nav a:hover {
    color: var(--beacon-ink);
    background: #f4f6f8;
  }
  .desktop-nav .nav-cta {
    margin-left: 0.35rem;
    background: var(--beacon-ink);
    color: white;
    padding-inline: 1rem;
  }
  .desktop-nav .nav-cta:hover {
    background: var(--beacon-orange);
    color: white;
  }
  .mobile-nav {
    display: none;
    position: relative;
  }
  .mobile-nav summary {
    list-style: none;
    width: 2.7rem;
    height: 2.7rem;
    border: 1px solid var(--beacon-line);
    border-radius: 50%;
    display: grid;
    place-content: center;
    gap: 0.28rem;
    cursor: pointer;
  }
  .mobile-nav summary::-webkit-details-marker {
    display: none;
  }
  .mobile-nav summary span {
    width: 1rem;
    height: 1px;
    display: block;
    background: var(--beacon-ink);
  }
  .mobile-nav nav {
    position: absolute;
    top: 3.2rem;
    right: 0;
    width: 13rem;
    padding: 0.55rem;
    background: #fffdfa;
    border: 1px solid var(--beacon-line);
    border-radius: 1rem;
    box-shadow: 0 18px 50px rgba(21, 40, 61, 0.12);
  }
  .mobile-nav nav a {
    display: block;
    padding: 0.75rem 0.85rem;
    color: var(--beacon-ink);
    text-decoration: none;
    font-weight: 700;
    border-radius: 0.7rem;
  }
  .mobile-nav nav a:hover {
    background: #f3f6f8;
  }

  .hero {
    min-height: calc(100svh - 4.85rem);
    display: grid;
    grid-template-columns: minmax(0, 0.94fr) minmax(460px, 1.12fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
    padding-block: clamp(4rem, 8vw, 7.5rem);
    overflow: hidden;
  }
  .hero-copy {
    position: relative;
    z-index: 2;
  }
  .eyebrow {
    margin: 0 0 1.15rem;
    display: flex;
    align-items: center;
    gap: 0.65rem;
    color: #6b7f93;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.72rem;
    font-weight: 800;
  }
  .eyebrow > span {
    width: 2.1rem;
    height: 1px;
    background: var(--beacon-orange);
  }
  .hero h1 {
    margin: 0;
    max-width: 760px;
    font-size: clamp(3.25rem, 7vw, 6.5rem);
    line-height: 0.94;
    letter-spacing: -0.068em;
    font-weight: 780;
  }
  .hero h1 em {
    color: var(--beacon-orange);
    font-style: normal;
    font-weight: 760;
  }
  .hero-lede {
    max-width: 690px;
    margin: 1.75rem 0 0;
    font-size: clamp(1.08rem, 2vw, 1.34rem);
    line-height: 1.65;
    color: #526b82;
    letter-spacing: -0.015em;
  }
  .hero-lede strong {
    color: var(--beacon-ink);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    min-height: 3rem;
    padding: 0.8rem 1.15rem;
    border-radius: 999px;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 760;
    transition:
      transform 0.2s ease,
      background 0.2s ease,
      border-color 0.2s ease;
  }
  .button:hover {
    transform: translateY(-2px);
  }
  .button-primary {
    background: var(--beacon-orange);
    color: white;
    box-shadow: 0 12px 28px rgba(244, 81, 30, 0.18);
  }
  .button-primary:hover {
    background: #da4619;
  }
  .button-ghost {
    border: 1px solid var(--beacon-line);
    color: var(--beacon-ink);
    background: white;
  }
  .button-ghost:hover {
    border-color: rgba(21, 40, 61, 0.25);
  }
  .human-note {
    margin: 1.25rem 0 0;
    color: #71869a;
    font-size: 0.82rem;
    display: flex;
    gap: 0.55rem;
    align-items: center;
  }
  .human-dot {
    width: 0.48rem;
    height: 0.48rem;
    border-radius: 50%;
    background: #6f8c55;
    box-shadow: 0 0 0 0.25rem rgba(111, 140, 85, 0.12);
  }

  .hero-visual {
    position: relative;
    aspect-ratio: 1;
    width: min(100%, 560px);
    justify-self: end;
    overflow: hidden;
  }
  .hero-journey {
    --moon-left: 19%;
    --moon-top: 78%;
    border-radius: 2.1rem;
    border: 1px solid rgba(21, 40, 61, 0.06);
    background:
      linear-gradient(180deg, #fffdf9 0%, #f5f7fb 50%, #eef2f7 100%);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.72),
      0 28px 90px rgba(50, 67, 88, 0.08);
    isolation: isolate;
  }
  .hero-sky,
  .hero-sun-haze,
  .hero-land,
  .moon-cast,
  .path-svg,
  .beacon-moon,
  .path-node,
  .destination-chip,
  .hero-stage-panel {
    position: absolute;
  }
  .hero-sky {
    inset: 0;
    background:
      radial-gradient(circle at 64% 18%, rgba(255, 248, 218, 0.82), rgba(255, 248, 218, 0) 25%),
      radial-gradient(circle at 22% 16%, rgba(232, 239, 248, 0.95), rgba(232, 239, 248, 0) 26%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.94) 0%, rgba(248, 250, 253, 0.92) 42%, rgba(239, 243, 249, 0.95) 100%);
  }
  .hero-sun-haze {
    inset: 18% 18% 22% 18%;
    border-radius: 50%;
    background:
      radial-gradient(circle at 50% 48%, rgba(245, 166, 35, 0.22), rgba(245, 166, 35, 0.08) 24%, rgba(245, 166, 35, 0) 56%),
      radial-gradient(circle at 50% 50%, rgba(21, 40, 61, 0.08), rgba(21, 40, 61, 0) 68%);
    filter: blur(16px);
    z-index: 0;
  }
  .hero-land {
    left: -8%;
    right: -8%;
    border-radius: 50% 50% 0 0 / 100% 100% 0 0;
    z-index: 0;
  }
  .hero-land-back {
    bottom: 31%;
    height: 28%;
    background: linear-gradient(180deg, rgba(222, 230, 240, 0.88), rgba(210, 221, 234, 0.96));
    clip-path: ellipse(57% 58% at 50% 52%);
  }
  .hero-land-mid {
    bottom: 19%;
    height: 26%;
    background: linear-gradient(180deg, rgba(234, 239, 245, 0.98), rgba(220, 228, 238, 1));
    clip-path: ellipse(62% 64% at 50% 58%);
  }
  .hero-land-front {
    bottom: -2%;
    height: 28%;
    background: linear-gradient(180deg, rgba(231, 236, 242, 1), rgba(220, 228, 238, 1));
    clip-path: ellipse(68% 72% at 50% 58%);
  }
  .path-svg {
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    z-index: 1;
  }
  .journey-path-shadow,
  .journey-path-base,
  .journey-path-progress {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .journey-path-shadow {
    stroke: rgba(245, 166, 35, 0.16);
    stroke-width: 56;
    filter: blur(18px);
    opacity: 0.9;
