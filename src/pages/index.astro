    height: 36%;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 248, 218, 0.94) 0%, rgba(245, 166, 35, 0.2) 44%, rgba(245, 166, 35, 0) 74%);
    filter: blur(10px);
    z-index: 2;
    pointer-events: none;
    transition:
      left 0.9s cubic-bezier(0.22, 1, 0.36, 1),
      top 0.9s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .beacon-moon {
    left: var(--moon-left);
    top: var(--moon-top);
    translate: -50% -50%;
    width: 18%;
    aspect-ratio: 1;
    border-radius: 50%;
    display: grid;
    place-items: center;
    z-index: 3;
    background: radial-gradient(circle at 48% 38%, #fff8d6 0 10%, #ffd86e 24%, #f5b53c 52%, #f07c38 76%, #f4511e 100%);
    box-shadow:
      0 0 0 0.95rem rgba(245, 166, 35, 0.1),
      0 0 3rem 0.95rem rgba(245, 166, 35, 0.34),
      0 0 6rem 1.6rem rgba(244, 81, 30, 0.08);
    transition:
      left 0.9s cubic-bezier(0.22, 1, 0.36, 1),
      top 0.9s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .beacon-moon::after {
    content: '';
    width: 40%;
    height: 40%;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 252, 235, 0.98), rgba(255, 222, 111, 0.92) 68%, rgba(244, 81, 30, 0.12));
    filter: blur(0.6px);
