---
const { item, index } = Astro.props;
---

<button
  class="involve-card"
  type="button"
  data-open-involvement={item.id}
  aria-haspopup="dialog"
  aria-controls={`involve-${item.id}`}
>
  <span class="involve-index">0{index + 1}</span>
  <span class="involve-eyebrow">{item.eyebrow}</span>
  <span class="involve-title">{item.title}</span>
  <span class="involve-summary">{item.summary}</span>
  <span class="involve-link">Learn how <span aria-hidden="true">↗</span></span>
</button>

<dialog class="involve-dialog" id={`involve-${item.id}`} data-involvement-dialog={item.id}>
  <button class="dialog-close" type="button" data-close-dialog aria-label="Close">×</button>
  <p class="dialog-kicker">Get involved</p>
  <h3>{item.dialogTitle}</h3>
  <p>{item.dialogBody}</p>
  <div class="next-step">
    <strong>Next step</strong>
    <span>{item.nextStep}</span>
  </div>
</dialog>

<style>
  .involve-card {
    min-height: 100%;
    padding: 1.55rem;
    border-radius: 1.55rem;
    border: 1px solid rgba(21, 40, 61, 0.11);
    background: rgba(255, 255, 255, 0.76);
    text-align: left;
    display: flex;
    flex-direction: column;
    color: #15283d;
    cursor: pointer;
    transition:
      transform 0.25s ease,
      border-color 0.25s ease,
      box-shadow 0.25s ease;
  }
  .involve-card:hover,
  .involve-card:focus-visible {
    transform: translateY(-4px);
    border-color: rgba(244, 81, 30, 0.35);
    box-shadow: 0 18px 52px rgba(21, 40, 61, 0.1);
  }
  .involve-card:focus-visible {
    outline: 3px solid rgba(69, 111, 166, 0.3);
    outline-offset: 4px;
  }
  .involve-index {
    align-self: flex-end;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    color: #8ca0b4;
    font-weight: 800;
  }
  .involve-eyebrow {
    margin-top: 2.25rem;
    color: #d95829;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.75rem;
    font-weight: 800;
  }
  .involve-title {
    margin-top: 0.58rem;
    font-size: 1.32rem;
    line-height: 1.16;
    letter-spacing: -0.035em;
    font-weight: 780;
  }
  .involve-summary {
    margin-top: 0.7rem;
    color: #60748b;
    line-height: 1.62;
    font-size: 0.94rem;
  }
  .involve-link {
    margin-top: auto;
    padding-top: 1.6rem;
    font-size: 0.85rem;
    font-weight: 760;
    color: #15283d;
  }
  .involve-dialog {
    width: min(580px, calc(100% - 2rem));
    border: 0;
    padding: 0;
    border-radius: 1.8rem;
    background: #fffdfa;
    color: #15283d;
    box-shadow: 0 38px 100px rgba(16, 38, 64, 0.28);
  }
  .involve-dialog::backdrop {
    background: rgba(20, 35, 52, 0.48);
    backdrop-filter: blur(4px);
  }
  .involve-dialog[open] {
    padding: 2rem;
  }
  .dialog-close {
    position: absolute;
    right: 1rem;
    top: 1rem;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    border: 1px solid rgba(21, 40, 61, 0.12);
    background: white;
    color: #15283d;
    cursor: pointer;
    font-size: 1.45rem;
    line-height: 1;
  }
  .dialog-kicker {
    margin: 0;
    color: #d95829;
    text-transform: uppercase;
    font-size: 0.72rem;
    letter-spacing: 0.15em;
    font-weight: 800;
  }
  h3 {
    margin: 0.55rem 3rem 0 0;
    font-size: clamp(1.55rem, 4vw, 2.05rem);
    letter-spacing: -0.04em;
  }
  p:not(.dialog-kicker) {
    margin: 1.15rem 0 0;
    line-height: 1.72;
    color: #405870;
  }
  .next-step {
    margin-top: 1.25rem;
    padding: 1rem 1.05rem;
    background: #f4f7fa;
    border-radius: 1rem;
    display: grid;
    gap: 0.35rem;
    color: #526b82;
    font-size: 0.9rem;
    line-height: 1.55;
  }
  .next-step strong {
    color: #15283d;
  }
</style>
